[Unit]
Description=Bebebendle competitive daily generation
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=deploy
WorkingDirectory=/opt/bebebendle/current
ExecStart=/opt/bebebendle/current/ops/cron-generate-competitive.sh
StandardOutput=append:/opt/bebebendle/shared/logs/competitive-cron.log
StandardError=append:/opt/bebebendle/shared/logs/competitive-cron.log
