# Bebebendle PRODUCTION — /opt/bebebendle/shared/.env
# Copy to .env and fill. Never commit. Mode 600.
# Do NOT reuse staging BOT_TOKEN / SESSION_SECRET / DB / SVAGA secrets.

APP_ENV=production
NODE_ENV=production

# Session (min 32 chars; prefer 64 hex)
SESSION_SECRET=

# PostgreSQL (filled by bootstrap once-file or set manually)
DATABASE_URL=postgresql://bebebendle:CHANGE_ME@127.0.0.1:5432/bebebendle_production

# Redis (localhost on this host)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# SVAGA+ on same host (internal API, not public)
SVAGAPLUS_INTERNAL_URL=http://127.0.0.1:5016
SVAGAPLUS_INTERNAL_SECRET=
SVAGA_TARGET_USER_ID=

# Bot → Bebebendle internal (different secret from SVAGA hop)
BEBEBENDLE_INTERNAL_SECRET=
BEBEBENDLE_INTERNAL_URL=http://127.0.0.1:3000

# Telegram
BOT_TOKEN=
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=

# Admin panel + cron (optional but recommended)
ADMIN_PASSWORD=
CRON_SECRET=

# Paths / ports
UPLOADS_DIR=/opt/bebebendle/shared/uploads
PORT=3000
BOT_HEALTH_HOST=127.0.0.1
BOT_HEALTH_PORT=3011
