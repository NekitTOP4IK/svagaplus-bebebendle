# =============================================================================
# Bebebendle Environment Variables
# Copy this file to .env and fill in the values.
# =============================================================================

# -----------------------------------------------------------------------------
# Telegram Bot (required)
# -----------------------------------------------------------------------------
BOT_TOKEN=your_bot_token_from_botfather

# -----------------------------------------------------------------------------
# Admin Panel & Cron
# -----------------------------------------------------------------------------
# Password for the old admin login (mostly deprecated, kept for compatibility)
ADMIN_PASSWORD=change_me_strong_password

# Secret used to protect the /api/cron/daily endpoint
CRON_SECRET=change_me_random_secret

# -----------------------------------------------------------------------------
# Database (PostgreSQL)
# -----------------------------------------------------------------------------
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=bebendle
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Full connection string used by Drizzle and some scripts
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# -----------------------------------------------------------------------------
# Redis (used for rate limiting)
# -----------------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379

# -----------------------------------------------------------------------------
# SVAGA+ Integration (new)
# -----------------------------------------------------------------------------
# URL to your svagaplus-server instance (internal endpoint)
# In Docker Compose this is usually the service name + port
SVAGAPLUS_INTERNAL_URL=http://svagaplus-server:8000

# Shared secret for internal communication between services
# (next <-> bot, next <-> svagaplus-server)
INTERNAL_SECRET=change_me_very_long_random_string

# -----------------------------------------------------------------------------
# Next.js Frontend
# -----------------------------------------------------------------------------
# Username of your Telegram bot (without @) — used by the login widget
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=your_bot_username

# -----------------------------------------------------------------------------
# Internal Service Communication
# -----------------------------------------------------------------------------
# URL that the bot uses to call the Next.js backend
# Default is correct for docker-compose
BEBEBENDLE_INTERNAL_URL=http://next:3000

# -----------------------------------------------------------------------------
# Optional / Advanced
# -----------------------------------------------------------------------------
# Custom uploads directory (usually not needed in Docker)
# UPLOADS_DIR=/app/uploads

# Node environment (development / production)
NODE_ENV=development
