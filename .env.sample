# Copy to .env (local) or /opt/bebebendle/shared/.env (PM2).
# Runtime secrets stay on the host; GitHub only holds DEPLOY_* transport secrets.

APP_ENV=development

# Public site URL (share text, absolute links). Staging/prod set per host.
# Client also falls back to window.location.origin if unset.
# NEXT_PUBLIC_SITE_URL=https://bebebendle.svagaplus.com
# NEXT_PUBLIC_APP_URL=https://bebebendle.svagaplus.com

# -----------------------------------------------------------------------------
# Telegram Bot (required)
# -----------------------------------------------------------------------------
BOT_TOKEN=your_bot_token_from_botfather
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=your_bot_username

# -----------------------------------------------------------------------------
# Session auth (required)
# -----------------------------------------------------------------------------
# At least 32 characters. Used to sign short-lived access tokens.
SESSION_SECRET=replace-with-64-random-hex-characters

# -----------------------------------------------------------------------------
# Competitive presentation (optional)
# -----------------------------------------------------------------------------
# HMAC pepper for per-user competitive daily shuffle + A/B flip.
# Falls back to SESSION_SECRET, then a dev-only default if unset.
# COMPETITIVE_PRESENTATION_SECRET=replace-with-64-random-hex-characters

# -----------------------------------------------------------------------------
# Admin Panel & Cron
# -----------------------------------------------------------------------------
ADMIN_PASSWORD=change_me_strong_password
CRON_SECRET=change_me_random_secret

# -----------------------------------------------------------------------------
# Database (PostgreSQL)
# -----------------------------------------------------------------------------
# Authoritative DSN for Next, bot, Drizzle migrations, and PM2 hosts.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/bebendle

# Compose-style split vars (fallback when DATABASE_URL is unset)
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=bebendle
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# -----------------------------------------------------------------------------
# Redis (rate limiting)
# -----------------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379

# -----------------------------------------------------------------------------
# SVAGA+ Integration
# -----------------------------------------------------------------------------
# Base URL of the SVAGA+ server (no trailing slash required)
SVAGAPLUS_INTERNAL_URL=http://127.0.0.1:5016
# Dedicated caller secret for Bebebendle -> SVAGA+ (do not reuse bot secrets)
SVAGAPLUS_INTERNAL_SECRET=replace-with-the-dedicated-svaga-secret
# SVAGA+ users.id for Olesha; all subscription checks are scoped to this owner
SVAGA_TARGET_USER_ID=replace-with-olesha-user-uuid

# -----------------------------------------------------------------------------
# Twitch OAuth (optional alternate login → resolves to Telegram via SVAGA+)
# -----------------------------------------------------------------------------
# Create an app at https://dev.twitch.tv/console — OAuth Redirect URL must
# match TWITCH_REDIRECT_URI exactly (include path).
# Local example: http://localhost:3000/api/auth/twitch/callback
# Prod example:  https://bebebendle.svagaplus.com/api/auth/twitch/callback
#
# If any of these three are unset, Twitch login returns 503 / profile error
# "config". Client secret never ships to the browser (server exchange only).
# Identity rule: no Twitch-only users — SVAGA must already link twitch_id →
# telegram_user_id (LinkedAccount). Uses same SVAGAPLUS_INTERNAL_* for lookup.
# TWITCH_CLIENT_ID=
# TWITCH_CLIENT_SECRET=
# TWITCH_REDIRECT_URI=http://localhost:3000/api/auth/twitch/callback

# -----------------------------------------------------------------------------
# Bot -> Bebebendle internal API
# -----------------------------------------------------------------------------
# Separate secret used by the Telegram bot when calling Bebebendle internal routes
BEBEBENDLE_INTERNAL_SECRET=replace-with-a-separate-bot-to-bebebendle-secret
BEBEBENDLE_INTERNAL_URL=http://127.0.0.1:3000

# -----------------------------------------------------------------------------
# Optional
# -----------------------------------------------------------------------------
# UPLOADS_DIR=/app/uploads
NODE_ENV=development
