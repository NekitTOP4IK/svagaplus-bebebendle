# =============================================================================
# Bebebendle Environment Variables
# Copy this file to .env (local) or /opt/bebebendle/shared/.env (PM2 hosts).
#
# Secrets model:
#   - Runtime secrets live in this file on the host (or local .env).
#   - GitHub Actions Environment secrets are ONLY for SSH deploy transport
#     (DEPLOY_HOST/USER/PATH/SSH_KEY/KNOWN_HOSTS) + vars.APP_URL.
#   - Do not put BOT_TOKEN / SESSION_SECRET / DATABASE_URL into GitHub.
# =============================================================================

APP_ENV=development

# -----------------------------------------------------------------------------
# Telegram Bot (required)
# -----------------------------------------------------------------------------
BOT_TOKEN=your_bot_token_from_botfather
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=your_bot_username

# -----------------------------------------------------------------------------
# Session auth (required)
# -----------------------------------------------------------------------------
# At least 32 characters. Used to sign short-lived access tokens.
SESSION_SECRET=replace-with-64-random-hex-characters

# -----------------------------------------------------------------------------
# Admin Panel & Cron
# -----------------------------------------------------------------------------
ADMIN_PASSWORD=change_me_strong_password
CRON_SECRET=change_me_random_secret

# -----------------------------------------------------------------------------
# Database (PostgreSQL)
# -----------------------------------------------------------------------------
# Authoritative DSN for Next, bot, Drizzle migrations, and PM2 hosts.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/bebendle

# Compose-style split vars (fallback when DATABASE_URL is unset)
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=bebendle
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# -----------------------------------------------------------------------------
# Redis (rate limiting)
# -----------------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379

# -----------------------------------------------------------------------------
# SVAGA+ Integration
# -----------------------------------------------------------------------------
# Base URL of the SVAGA+ server (no trailing slash required)
SVAGAPLUS_INTERNAL_URL=http://127.0.0.1:5016
# Dedicated caller secret for Bebebendle -> SVAGA+ (do not reuse bot secrets)
SVAGAPLUS_INTERNAL_SECRET=replace-with-the-dedicated-svaga-secret
# SVAGA+ users.id for Olesha; all subscription checks are scoped to this owner
SVAGA_TARGET_USER_ID=replace-with-olesha-user-uuid

# -----------------------------------------------------------------------------
# Bot -> Bebebendle internal API
# -----------------------------------------------------------------------------
# Separate secret used by the Telegram bot when calling Bebebendle internal routes
BEBEBENDLE_INTERNAL_SECRET=replace-with-a-separate-bot-to-bebebendle-secret
BEBEBENDLE_INTERNAL_URL=http://127.0.0.1:3000

# -----------------------------------------------------------------------------
# Optional
# -----------------------------------------------------------------------------
# UPLOADS_DIR=/app/uploads
NODE_ENV=development
